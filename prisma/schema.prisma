generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Customer {
  id            String   @id @default(cuid())
  customerCode  String?  @unique
  name          String
  customerGroup String?
  agency        String?
  phone         String?
  address       String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  orders        Order[]
  leads         Lead[]
  opportunities Opportunity[]
  activities    Activity[]
  followUps     FollowUp[]
}

model Order {
  id                     String             @id @default(cuid())
  orderNumber            String             @unique
  salesRep               String?
  convertedBy            String?
  invoicedAt             DateTime?
  customerId             String
  customer               Customer           @relation(fields: [customerId], references: [id])
  customerOrderNumber    String?
  orderDate              DateTime           @default(now())
  deliveryDate           DateTime?
  priority               String             @default("عادی")
  mapGroup               String?
  mapNumber              String?
  customerDocumentNumber String?
  totalMeterage          Float              @default(0)
  totalQuantity          Int                @default(0)
  hasInstallation        Boolean            @default(false)
  installationDate       DateTime?
  installationAddress    String?
  installationPhone      String?
  installationNotes      String?
  discountAmount         Float              @default(0)
  discountPercent        Float?
  isOfficialInvoice      Boolean            @default(false)
  isStop                 Boolean            @default(false)
  status                 String             @default("ثبت‌شده")
  mapImageUrl            String?
  mapImages              String?
  notes                  String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  items                  OrderItem[]
  productionOrders       ProductionOrder[]
}

model OrderItem {
  id               String             @id @default(cuid())
  orderId          String
  order            Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productName      String
  pieceNumber      String?
  installationCode String?
  unit             String?
  length           Float
  width            Float
  quantity         Int                @default(1)
  meterage         Float              @default(0)
  perimeter        Float              @default(0)
  unitPrice        Float              @default(0)
  totalPrice       Float              @default(0)
  flagged          Boolean            @default(false)
  servicesData     String?
  status           String?
  notes            String?
  sortOrder        Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  services         OrderItemService[]
}

model OrderItemService {
  id              String    @id @default(cuid())
  orderItemId     String
  orderItem       OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  serviceId       String
  service         Service   @relation(fields: [serviceId], references: [id])
  calculationType String
  value           Float     @default(0)
  unitPrice       Float     @default(0)
  totalPrice      Float     @default(0)
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Service {
  id                String             @id @default(cuid())
  name              String
  category          String
  defaultCalcType   String?
  defaultUnitPrice  Float              @default(0)
  isActive          Boolean            @default(true)
  isFrequent        Boolean            @default(false)
  sortOrder         Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  orderItemServices OrderItemService[]
}

model ProductionStation {
  id           String                  @id @default(cuid())
  name         String
  code         String?                 @unique
  description  String?
  sortOrder    Int                     @default(0)
  isActive     Boolean                 @default(true)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  itemStations ProductionItemStation[]
  history      ProductionHistory[]
}

model ProductionOrder {
  id               String               @id @default(cuid())
  orderId          String
  order            Order                @relation(fields: [orderId], references: [id])
  productionNumber String               @unique
  status           String               @default("در انتظار")
  priority         String               @default("عادی")
  notes            String?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  createdBy        String?
  items            ProductionItem[]
  history          ProductionHistory[]
}

model ProductionItem {
  id                  String                  @id @default(cuid())
  productionOrderId   String
  productionOrder     ProductionOrder         @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  orderItemId         String?
  productName         String
  length              Float?
  width               Float?
  quantity            Int                     @default(1)
  meterage            Float?
  thickness           String?
  notes               String?
  status              String                  @default("در انتظار")
  barcode             String?                 @unique
  currentStationId    String?
  labelStatus         String                  @default("چاپ‌نشده")
  labelPrintCount     Int                     @default(0)
  labelPrintedAt      DateTime?
  labelReprintAllowed Boolean                 @default(false)
  parentItemId        String?
  recutNumber         Int                     @default(0)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  stations            ProductionItemStation[]
  history             ProductionHistory[]
  wastes              Waste[]
}

model ProductionItemStation {
  id               String              @id @default(cuid())
  productionItemId String
  productionItem   ProductionItem      @relation(fields: [productionItemId], references: [id], onDelete: Cascade)
  stationId        String
  station          ProductionStation   @relation(fields: [stationId], references: [id])
  sequence         Int
  status           String              @default("در انتظار")
  quantityIn       Int?
  quantityOut      Int?
  quantityWaste    Int?
  startedAt        DateTime?
  completedAt      DateTime?
  operatorId       String?
  notes            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  history          ProductionHistory[]
}

model ProductionHistory {
  id                      String                 @id @default(cuid())
  productionOrderId       String?
  productionOrder         ProductionOrder?       @relation(fields: [productionOrderId], references: [id])
  productionItemId        String?
  productionItem          ProductionItem?        @relation(fields: [productionItemId], references: [id])
  productionItemStationId String?
  productionItemStation   ProductionItemStation? @relation(fields: [productionItemStationId], references: [id])
  stationId               String?
  station                 ProductionStation?     @relation(fields: [stationId], references: [id])
  action                  String
  description             String?
  oldStatus               String?
  newStatus               String?
  quantity                Int?
  operatorId              String?
  operatorName            String?
  createdAt               DateTime               @default(now())
}

model Waste {
  id               String         @id @default(cuid())
  productionItemId String
  productionItem   ProductionItem @relation(fields: [productionItemId], references: [id], onDelete: Cascade)
  stationId        String?
  quantity         Int
  reason           String?
  notes            String?
  operatorId       String?
  isReworked       Boolean        @default(false)
  recutItemId      String?
  recutAt          DateTime?
  createdAt        DateTime       @default(now())
}

model User {
  id                    String        @id @default(cuid())
  username              String        @unique
  passwordHash          String
  displayName           String
  role                  String
  stationName           String?
  isActive              Boolean       @default(true)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  assignedLeads         Lead[]        @relation("LeadAssignee")
  assignedOpportunities Opportunity[] @relation("OpportunityAssignee")
  createdActivities     Activity[]    @relation("ActivityCreator")
  assignedFollowUps     FollowUp[]    @relation("FollowUpAssignee")
}

// ====================== برگه خروج / بارگیری ======================

model ExitSlip {
  id               String         @id @default(cuid())
  exitNumber       String         @unique
  customerId       String?
  customerName     String
  customerPhone    String?
  exitDate         DateTime       @default(now())
  driverName       String?
  driverNationalId String?
  driverPhone      String?
  vehicleName      String?
  plateNumber      String?
  printCount       Int            @default(0)
  notes            String?
  createdBy        String?
  createdByName    String?
  status           String         @default("ثبت‌شده")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  items            ExitSlipItem[]
}

model ExitSlipItem {
  id               String    @id @default(cuid())
  exitSlipId       String
  exitSlip         ExitSlip  @relation(fields: [exitSlipId], references: [id], onDelete: Cascade)
  productionItemId String
  orderId          String?
  orderNumber      String?
  productName      String
  length           Float?
  width            Float?
  quantity         Int       @default(1)
  meterage         Float?
  installationCode String?
  servicesText     String?
  notes            String?
  barcode          String?
  loadedAt         DateTime?
  createdAt        DateTime  @default(now())
}

// ====================== CRM ======================

model Lead {
  id              String        @id @default(cuid())
  name            String
  companyName     String?
  mobile          String?
  phone           String?
  whatsapp        String?
  city            String?
  customerType    String?
  productInterest String?
  description     String?
  source          String        @default("Other")
  campaign        String?
  status          String        @default("NEW")
  estimatedValue  Float?
  probability     Int?
  nextAction      String?
  nextActionDate  DateTime?
  lastActivityAt  DateTime?
  convertedAt     DateTime?
  lostNote        String?
  lostReasonId    String?
  lostReason      LostReason?   @relation(fields: [lostReasonId], references: [id])
  assignedToId    String?
  assignedTo      User?         @relation("LeadAssignee", fields: [assignedToId], references: [id])
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id])
  opportunities   Opportunity[]
  activities      Activity[]
  followUps       FollowUp[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Opportunity {
  id               String        @id @default(cuid())
  title            String?
  status           String        @default("OPEN")
  priority         String        @default("عادی")
  estimatedValue   Float?
  probability      Int?
  nextAction       String?
  nextActionDate   DateTime?
  lastActivityAt   DateTime?
  wonAt            DateTime?
  lostAt           DateTime?
  lostNote         String?
  stageId          String
  stage            PipelineStage @relation(fields: [stageId], references: [id])
  lostReasonId     String?
  lostReason       LostReason?   @relation(fields: [lostReasonId], references: [id])
  leadId           String?
  lead             Lead?         @relation(fields: [leadId], references: [id])
  customerId       String?
  customer         Customer?     @relation(fields: [customerId], references: [id])
  assignedToId     String?
  assignedTo       User?         @relation("OpportunityAssignee", fields: [assignedToId], references: [id])
  quotationOrderId String?
  wonOrderId       String?
  activities       Activity[]
  followUps        FollowUp[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model PipelineStage {
  id            String        @id @default(cuid())
  name          String        @unique
  code          String?       @unique
  sortOrder     Int           @default(0)
  isWon         Boolean       @default(false)
  isLost        Boolean       @default(false)
  isActive      Boolean       @default(true)
  opportunities Opportunity[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Activity {
  id            String       @id @default(cuid())
  type          String
  title         String?
  description   String?
  result        String?
  activityAt    DateTime     @default(now())
  leadId        String?
  lead          Lead?        @relation(fields: [leadId], references: [id])
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  customerId    String?
  customer      Customer?    @relation(fields: [customerId], references: [id])
  createdById   String?
  createdBy     User?        @relation("ActivityCreator", fields: [createdById], references: [id])
  createdAt     DateTime     @default(now())
}

model FollowUp {
  id            String       @id @default(cuid())
  type          String       @default("CALL")
  description   String?
  dueDate       DateTime
  status        String       @default("PENDING")
  result        String?
  completedAt   DateTime?
  leadId        String?
  lead          Lead?        @relation(fields: [leadId], references: [id])
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  customerId    String?
  customer      Customer?    @relation(fields: [customerId], references: [id])
  assignedToId  String?
  assignedTo    User?        @relation("FollowUpAssignee", fields: [assignedToId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model LostReason {
  id            String        @id @default(cuid())
  name          String        @unique
  sortOrder     Int           @default(0)
  isActive      Boolean       @default(true)
  leads         Lead[]
  opportunities Opportunity[]
  createdAt     DateTime      @default(now())
}